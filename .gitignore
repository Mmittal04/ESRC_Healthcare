# Raw and processed data are open but large (up to 89 MB); they stay local.
# data/raw/MANIFEST.md records sources and checksums so anyone can rebuild them.
data/raw/*
!data/raw/MANIFEST.md
!data/raw/download_log.csv
data/processed/*
!data/processed/.gitkeep

# Outputs are rebuilt by the scripts; the finished map is committed so it can
# be viewed on GitHub (recommit after re-running R/03_map.R).
outputs/*
!outputs/.gitkeep
!outputs/gp-map-a1.pdf
!outputs/gp-map-a1-preview.png

# R and Quarto
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/
renv/local/
/.quarto/
*_files/
*.html

# macOS
.DS_Store

**/*.quarto_ipynb
